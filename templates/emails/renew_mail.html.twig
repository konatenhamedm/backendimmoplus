{% extends 'emails/base.html.twig' %}

{% block title %}RENOUVELLEMENT D'ABONNEMENT{% endblock %}

{% block body %}
    <p>Bonjour,</p>
    <p>Nous vous informons que votre abonnement Immoplus a été renouvelé avec succès. Merci de continuer à utiliser nos services !</p>

    <div class="card">
        <div class="label">Date de renouvellement</div>
        <div class="value">{{ "now"|date("d/m/Y H:i") }}</div>

        <div class="label">Nouvelle Date d'expiration</div>
        <div class="value" style="color: #059669; font-size: 18px;">{{ expirationDate|date("d/m/Y") }}</div>

        <div class="label">Plan Actuel</div>
        <div class="value" style="color: #7C3AED;">{{ planName }}</div>
    </div>

    <p style="font-size: 11px; color: #64748b; margin-top: 20px;">
        Votre accès à la plateforme est désormais prolongé jusqu'à la date indiquée ci-dessus. Vous pouvez retrouver tous les détails de votre facturation dans votre espace client.
    </p>

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/dashboard" class="button">Accéder à mon application</a>
    </div>

    <p>Nous vous souhaitons une excellente gestion immobilière !</p>
    <p>L'équipe Clients Immoplus</p>
{% endblock %}
