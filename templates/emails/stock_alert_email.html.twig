{% extends 'emails/base.html.twig' %}

{% block title %}🚨 ALERTE STOCK URGENT{% endblock %}

{% block body %}
    <div style="background-color: #dc3545; color: white; padding: 10px 20px; border-radius: 8px; text-align: center; font-weight: bold; margin-bottom: 20px;">
        Priorité {{ priority_level }} - {{ total_items_in_shortage }} article{{ total_items_in_shortage > 1 ? 's' : '' }} en rupture
    </div>

    <p>Une nouvelle réservation vient d'être enregistrée pour la boutique <strong>{{ boutique_name }}</strong>, mais certains articles sont en rupture de stock.</p>

    <div class="grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px;">
        <div class="card" style="margin: 0;">
            <div class="label">Client</div>
            <div class="value">{{ client_name }}</div>
            {% if client_phone %}<div class="label">Téléphone</div><div class="value">{{ client_phone }}</div>{% endif %}
        </div>
        <div class="card" style="margin: 0;">
            <div class="label">Boutique / Entreprise</div>
            <div class="value">{{ boutique_name }}</div>
            <div class="value" style="font-size: 12px; opacity: 0.7;">{{ entreprise_name }}</div>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-top: 0; color: #1e293b; font-size: 14px; text-transform: uppercase;">Détails Financiers</h3>
        <hr>
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span class="label">Total</span>
            <span class="value" style="margin: 0;">{{ total_amount|number_format(0, ',', ' ') }} FCFA</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span class="label">Avance</span>
            <span class="value" style="margin: 0; color: #059669;">{{ advance_amount|number_format(0, ',', ' ') }} FCFA</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
            <span class="label">Reste</span>
            <span class="value" style="margin: 0; color: #dc3545;">{{ remaining_amount|number_format(0, ',', ' ') }} FCFA</span>
        </div>
    </div>

    <h3 style="color: #dc3545; font-size: 14px; text-transform: uppercase; margin-top: 30px;">Articles en Rupture</h3>
    {% for deficit in stock_deficits %}
    <div class="card" style="border-left: 4px solid #dc3545;">
        <div class="value" style="margin-bottom: 15px;">{{ deficit.modele_name }}</div>
        <table width="100%">
            <tr>
                <td width="25%">
                    <div class="label">Demandé</div>
                    <div class="value" style="margin: 0;">{{ deficit.quantity_requested }}</div>
                </td>
                <td width="25%">
                    <div class="label">Dispo</div>
                    <div class="value" style="margin: 0;">{{ deficit.quantity_available }}</div>
                </td>
                <td width="25%">
                    <div class="label">Déficit</div>
                    <div class="value" style="margin: 0; color: #dc3545;">{{ deficit.deficit }}</div>
                </td>
                <td width="25%">
                    <div class="label">Manquant</div>
                    <div class="value" style="margin: 0;">{{ deficit.deficit_percentage|number_format(1) }}%</div>
                </td>
            </tr>
        </table>
    </div>
    {% endfor %}

    <div style="background-color: #f1f5f9; padding: 20px; border-radius: 12px; margin-top: 30px; text-align: center;">
        <p style="margin: 0; font-weight: bold; color: #0081ff;">Action Requise : Réservation #{{ reservation_id }}</p>
        <p style="font-size: 12px; color: #64748b; margin-top: 5px;">Veuillez procéder au ravitaillement pour finaliser cette commande.</p>
    </div>
{% endblock %}