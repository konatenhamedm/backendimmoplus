{% extends 'emails/base.html.twig' %}

{% block title %}CONFIRMATION DE PAIEMENT{% endblock %}

{% block body %}
    <p>Bonjour {{ name }},</p>
    <p>Nous vous confirmons la réception de votre paiement pour votre abonnement Immoplus. Merci de votre confiance !</p>

    <div class="card">
        <div class="label">Date de Transaction</div>
        <div class="value">{{ date|date("d/m/Y H:i") }}</div>

        <div class="label">Plan choisi</div>
        <div class="value" style="color: #7C3AED; font-size: 18px;">{{ planName }}</div>

        <div class="label">Montant Réglé</div>
        <div class="value" style="font-size: 18px;">{{ amount|number_format(0, ',', ' ') }} FCFA</div>

        <div class="label">ID de Transaction</div>
        <div class="value" style="font-family: monospace;">{{ transactionId }}</div>
    </div>

    <p style="font-size: 11px; color: #64748b;">
        Vous recevrez prochainement votre facture acquittée par email. Votre abonnement est désormais pleinement actif.
    </p>

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/dashboard" class="button">Retourner à mon application</a>
    </div>

    <p>Merci encore de choisir Immoplus.</p>
    <p>L'équipe Comptabilité</p>
{% endblock %}
