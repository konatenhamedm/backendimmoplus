{% extends 'emails/base.html.twig' %}

{% block title %}💰 NOUVEAU PAIEMENT ENCAISSÉ{% endblock %}

{% block body %}
    <p>Bonjour {{ admin_name }},</p>
    <p>Une nouvelle opération d'encaissement a été enregistrée avec succès par l'un de vos agents sur la plateforme.</p>

    <div class="card" style="text-align: center; border-bottom: 4px solid #7C3AED;">
        <div class="label">Montant Encaissé</div>
        <div class="value" style="font-size: 32px; color: #7C3AED; margin: 10px 0;">{{ amount|number_format(0, ',', ' ') }} FCFA</div>
        <div style="font-size: 11px; color: #059669; font-weight: bold;">✅ TRANSACTION TERMINÉE</div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">
            <span class="label">Agent</span>
            <span class="value" style="margin: 0;">{{ agent_name }}</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">
            <span class="label">Locataire</span>
            <span class="value" style="margin: 0;">{{ locataire_name }}</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">
            <span class="label">Facture</span>
            <span class="value" style="margin: 0;">{{ facture_libelle }}</span>
        </div>
        {% if mode is defined %}
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">
            <span class="label">Mode</span>
            <span class="value" style="margin: 0;">{{ mode }}</span>
        </div>
        {% endif %}
        <div style="display: flex; justify-content: space-between;">
            <span class="label">Date / Heure</span>
            <span class="value" style="margin: 0;">{{ date|date("d/m/Y H:i") }}</span>
        </div>
    </div>

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/facture-location" class="button">Consulter sur le Dashboard</a>
    </div>

    <p style="font-size: 11px; color: #64748b; text-align: center;">Système automatisé de suivi des encaissements Immoplus</p>
{% endblock %}
