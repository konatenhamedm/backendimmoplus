{% extends 'emails/base.html.twig' %}

{% block title %}NOUVELLE INSCRIPTION ENTREPRISE{% endblock %}

{% block body %}
    <p>Bonjour l'équipe,</p>
    <p>Une nouvelle inscription entreprise a été effectuée sur la plateforme.</p>

    <div class="card">
        <div class="label">Date d'inscription</div>
        <div class="value">{{ "now"|date("d/m/Y H:i") }}</div>

        <div class="label">Dénomination Entreprise</div>
        <div class="value" style="color: #7C3AED; font-size: 18px;">{{ entreprise.libelle }}</div>

        {% if entreprise.sigle %}
        <div class="label">Sigle</div>
        <div class="value">{{ entreprise.sigle }}</div>
        {% endif %}

        <div class="label">Nom Administrateur</div>
        <div class="value">{{ admin.nom }} {{ admin.prenoms }}</div>

        <div class="label">Contacts</div>
        <div class="value">{{ entreprise.contacts }}</div>

        <div class="label">Email</div>
        <div class="value"><a href="mailto:{{ entreprise.email }}" style="color: #7C3AED;">{{ entreprise.email }}</a></div>
    </div>

    <p>Le compte a été créé par défaut. Veuillez effectuer les vérifications administratives si nécessaire.</p>

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/dashboard" class="button">Accéder au Panneau d'Administration</a>
    </div>

    <p>Équipe de surveillance Immoplus</p>
{% endblock %}
