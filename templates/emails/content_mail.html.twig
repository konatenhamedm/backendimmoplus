{% extends 'emails/base.html.twig' %}

{% block title %}BIENVENUE SUR IMMOPLUS{% endblock %}

{% block body %}
    <p>Bonjour,</p>
    <p>Votre compte utilisateur a été créé avec succès. Voici vos informations de connexion pour accéder à votre espace :</p>

    <div class="card">
        <div class="label">Identifiant (Login)</div>
        <div class="value" style="color: #7C3AED;">{{ info_user.login }}</div>

        <div class="label">Mot de passe</div>
        <div class="value"><em>Utilisez le mot de passe défini lors de l'inscription</em></div>
    </div>

    <div style="text-align: center; margin-top: 30px;">
        <p>Veuillez cliquer sur le lien suivant pour vous connecter :</p>
        <a href="https://web.motiplus.pro/login" class="button">Se connecter à mon espace</a>
    </div>

    <p style="font-size: 11px; color: #64748b; margin-top: 20px;">
        Besoin d'aide ? N'hésitez pas à répondre à cet email ou à contacter notre support technique.
    </p>

    <p>Bienvenue parmi nous !</p>
    <p>L'équipe Immoplus</p>
{% endblock %}
