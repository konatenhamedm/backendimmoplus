<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; background-color: #f8fafc; padding: 40px 20px; color: #1e293b; margin: 0; }
        .wrapper { max-width: 600px; margin: 0 auto; background-color: white; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .header { background: linear-gradient(135deg, #7C3AED 0%, #5B21B6 100%); padding: 50px 30px; text-align: center; position: relative; }
        .header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 4px; background: rgba(0,0,0,0.1); }
        .header h1 { color: white !important; margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.025em; text-transform: uppercase; }
        .content { padding: 40px 35px; }
        .footer { background-color: #f1f5f9; color: #64748b; text-align: center; padding: 30px; font-size: 12px; border-top: 1px solid #e2e8f0; }
        .button { display: inline-block; padding: 16px 32px; background-color: #7C3AED; color: white !important; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 14px; margin: 25px 0; transition: transform 0.2s; box-shadow: 0 4px 6px -1px rgba(124, 58, 237, 0.4); }
        .card { background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 25px; margin: 20px 0; box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1); }
        .label { font-weight: 700; color: #94a3b8; text-transform: uppercase; font-size: 10px; letter-spacing: 0.1em; margin-bottom: 6px; }
        .value { color: #0f172a; font-weight: 700; margin-bottom: 16px; font-size: 16px; }
        hr { border: 0; border-top: 1px solid #f1f5f9; margin: 25px 0; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    </style>
</head>
<body>

<div class="wrapper">
    <div class="header">
        <h1 style="color: white !important;">{% block title %}IMMOPLUS{% endblock %}</h1>
    </div>

    <div class="content">
        {% block body %}{% endblock %}
    </div>

    <div class="footer">
        <p style="margin: 0;">© {{ "now"|date("Y") }} Motiplus - Gestion Immobilière Intelligente</p>
        <p style="margin: 5px 0 0 0; opacity: 0.7;">Abidjan, Côte d'Ivoire</p>
    </div>
</div>

</body>
</html>
