{% extends 'emails/base.html.twig' %}

{% block title %}NOUVELLE DEMANDE{% endblock %}

{% block body %}
    <p>Bonjour l'équipe,</p>
    <p>Une nouvelle demande de plan annuel a été soumise depuis la landing page.</p>

    <div class="card">
        <div class="label">Plan souhaité</div>
        <div class="value" style="color: #7C3AED; font-size: 18px;">{{ planName }}</div>

        <div class="label">Nom complet</div>
        <div class="value">{{ name }}</div>

        <div class="label">Agence / Entreprise</div>
        <div class="value">{{ company }}</div>

        <div class="label">Email de contact</div>
        <div class="value"><a href="mailto:{{ email_content }}" style="color: #7C3AED;">{{ email_content }}</a></div>

        <div class="label">Téléphone</div>
        <div class="value">{{ phone }}</div>

        {% if message %}
        <hr>
        <div class="label">Message / Précisions</div>
        <div class="value" style="font-style: italic; font-weight: 400;">"{{ message }}"</div>
        {% endif %}
    </div>

    <p>Veuillez recontacter ce prospect dans les plus brefs délais pour finaliser son inscription.</p>
{% endblock %}
