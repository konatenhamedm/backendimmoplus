{% extends 'emails/template.html.twig' %}

{% block body %}
    <p>Bonjour l'équipe,</p>
    <p>Une nouvelle demande d'abonnement annuelle a été soumise depuis la landing page.</p>

    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 20px 0;">
        <h3 style="margin-top: 0; color: #7c3aed;">Détails de la demande :</h3>
        <ul style="list-style: none; padding: 0;">
            <li><strong>Plan souhaité :</strong> {{ planName }}</li>
            <li><strong>Nom complet :</strong> {{ name }}</li>
            <li><strong>Agence / Entreprise :</strong> {{ company }}</li>
            <li><strong>Email :</strong> <a href="mailto:{{ email_content }}">{{ email_content }}</a></li>
            <li><strong>Téléphone :</strong> {{ phone }}</li>
        </ul>
        
        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #e2e8f0;">
            <strong>Message / Précisions :</strong><br>
            <p style="white-space: pre-wrap; font-style: italic;">{{ message|default('Aucun message supplémentaire') }}</p>
        </div>
    </div>

    <p>Veuillez contacter ce prospect dès que possible pour finaliser son abonnement.</p>
{% endblock %}
