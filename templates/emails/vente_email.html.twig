{% extends 'emails/base.html.twig' %}

{% block title %}CONFIRMATION DE VENTE{% endblock %}

{% block body %}
    <p>Bonjour {{ name }},</p>
    <p>Merci pour votre achat ! Votre commande a été enregistrée avec succès. Voici les détails de votre transaction :</p>

    <div class="card">
        <div class="label">Date de Transaction</div>
        <div class="value">{{ date|date("d/m/Y H:i") }}</div>

        <div class="label">Montant Total</div>
        <div class="value" style="color: #7C3AED; font-size: 20px;">{{ amount|number_format(0, ',', ' ') }} FCFA</div>

        <div class="label">ID de Commande</div>
        <div class="value" style="font-family: monospace;">{{ transactionId }}</div>
    </div>

    <h3 style="color: #1e293b; font-size: 14px; text-transform: uppercase; margin-top: 30px;">Détails de la commande</h3>
    <table width="100%" style="border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #e2e8f0;">
                <th align="left" style="padding: 12px 0;"><span class="label">Article</span></th>
                <th align="center" style="padding: 12px 0;"><span class="label">Qté</span></th>
                <th align="right" style="padding: 12px 0;"><span class="label">Total</span></th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
            <tr style="border-bottom: 1px solid #f1f5f9;">
                <td style="padding: 12px 0;"><div class="value" style="margin: 0; font-size: 14px;">{{ item.name }}</div></td>
                <td align="center" style="padding: 12px 0;"><div class="value" style="margin: 0; font-size: 14px;">{{ item.quantity }}</div></td>
                <td align="right" style="padding: 12px 0;"><div class="value" style="margin: 0; font-size: 14px;">{{ item.total|number_format(0, ',', ' ') }} FCFA</div></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="text-align: center; margin-top: 30px;">
        <p>Merci de votre fidélité !</p>
        <a href="https://web.motiplus.pro/dashboard" class="button">Accéder à mon compte</a>
    </div>

    <p>L'équipe Commerciale Immoplus</p>
{% endblock %}
