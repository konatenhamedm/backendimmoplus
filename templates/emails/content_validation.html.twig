{% extends 'emails/base.html.twig' %}

{% block title %}SUIVI DE VOTRE DOSSIER{% endblock %}

{% block body %}
    {% if info_user.etape == "acceptation" %}
        <div class="card">
            <h3 style="margin-top: 0; color: #1e293b;">Accusé de réception</h3>
            <p><strong>À l'attention de M/Mme {{ info_user.nom }},</strong></p>

            <p>Nous tenons à confirmer que nous avons bien reçu votre demande et que votre dossier est actuellement en cours d'instruction.</p>
            <p>Une suite sera donnée prochainement à votre demande relative à l’inscription au registre des <strong>{{ info_user.profession }}</strong>.</p>
            
            <hr>
            <p style="font-size: 13px; color: #64748b;">Pour toute information complémentaire, veuillez nous contacter directement au <strong>07 68 15 32 21</strong>.</p>
        </div>
    {% elseif info_user.etape == "validation" %}
        <div class="card" style="border-left: 4px solid #059669;">
            <h3 style="margin-top: 0; color: #059669;">Avis Favorable</h3>
            <p><strong>À l'attention de M/Mme {{ info_user.nom }},</strong></p>

            <p>Après instruction de votre dossier et tenue de la commission de recensement, nous avons le plaisir de vous annoncer que <strong>votre demande a été acceptée</strong>.</p>

            <p>Vous êtes inscrit au registre des <strong>{{ info_user.profession }}</strong> habilité(e) à exercer au titre de l’année <strong>{{ info_user.annee }}</strong>.</p>

            <p>À cet effet, vous êtes priés de vous rendre à nos bureaux pour le retrait de votre attestation d’inscription et de votre carte professionnelle.</p>
        </div>
    {% else %}
        <div class="card">
            {% if info_user.message is not empty %}
                <p>{{ info_user.message }}</p>
            {% else %}
                <p>Votre dossier vient de franchir l'étape : <strong>{{ info_user.etape }}</strong></p>
                <p style="font-size: 13px; color: #64748b;">Traité par {{ info_user.user }}</p>
            {% endif %}
        </div>
    {% endif %}

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/dashboard" class="button">Suivre mon dossier en ligne</a>
    </div>

    <p>Cordialement,</p>
    <p>L'équipe Administrative Immoplus</p>
{% endblock %}
