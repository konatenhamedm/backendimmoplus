{% extends 'emails/base.html.twig' %}

{% block title %}VOTRE ABONNEMENT IMMOPLUS{% endblock %}

{% block body %}
    <p>Bonjour,</p>
    <p>Félicitations ! Votre souscription au plan <strong>{{ abonnement.moduleAbonnement.code }}</strong> a été activée. Vous profitez désormais de toutes les fonctionnalités avancées de gestion immobilière de votre offre.</p>

    <div class="card">
        <div class="label">Référence Contrat</div>
        <div class="value" style="font-family: monospace;">{{ abonnement.numAbonnement }}</div>

        <div class="label">Plan Actif</div>
        <div class="value" style="color: #7C3AED; font-size: 18px;">{{ abonnement.moduleAbonnement.code|upper }}</div>

        <div class="label">Prochaine Échéance</div>
        <div class="value" style="color: #dc3545;">{{ abonnement.dateFin|date("d/m/Y") }}</div>

        <div class="label">Statut</div>
        <div class="value" style="color: #059669;">{{ (abonnement.etat) ? 'ACTIF' : 'INACTIF' }}</div>
    </div>

    <h3 style="color: #1e293b; font-size: 14px; text-transform: uppercase; margin-top: 30px;">Ce qui est inclus dans votre offre :</h3>
    <ul style="padding-left: 20px; font-size: 14px;">
        <li>Nombre d'agences : {{ (abonnement.moduleAbonnement.maxAgences == -1) ? 'Illimité' : abonnement.moduleAbonnement.maxAgences }}</li>
        <li>Nombre d'employés : {{ (abonnement.moduleAbonnement.maxEmployes == -1) ? 'Illimité' : abonnement.moduleAbonnement.maxEmployes }}</li>
        <li>Nombre de biens : {{ (abonnement.moduleAbonnement.maxBiens == -1) ? 'Illimité' : abonnement.moduleAbonnement.maxBiens }}</li>
        <li>Nombre de résidences : {{ (abonnement.moduleAbonnement.maxResidences == -1) ? 'Illimité' : abonnement.moduleAbonnement.maxResidences }}</li>
    </ul>

    <div style="text-align: center; margin-top: 30px;">
        <a href="https://web.motiplus.pro/dashboard" class="button">Accéder à mon tableau de bord</a>
    </div>

    <p>Besoin d'un accompagnement pour configurer votre compte ? Contactez notre support technique.</p>
    
    <p>L'équipe Success Immoplus</p>
{% endblock %}
