{% extends 'emails/base.html.twig' %}

{% block title %}RÉINITIALISATION DE MOT DE PASSE{% endblock %}

{% block body %}
    <p style="margin-bottom: 20px;">Bonjour {{ user.email }},</p>
    
    <p style="margin-bottom: 30px;">Pour votre demande de réinitialisation de mot de passe, veuillez cliquer sur le bouton suivant :</p>

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ url }}" style="display: inline-block; padding: 16px 32px; background-color: #7C3AED; color: white !important; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 14px; box-shadow: 0 4px 6px -1px rgba(124, 58, 237, 0.4);">Réinitialiser mon mot de passe</a>
    </div>

    <div style="background-color: #f1f5f9; border-radius: 12px; padding: 20px; margin-top: 30px;">
        <p style="font-size: 11px; color: #64748b; margin: 0;">
            Si vous ne parvenez pas à cliquer sur le bouton, copiez et collez l'URL suivante dans votre navigateur :<br>
            <span style="color: #7C3AED; overflow-wrap: break-word;">{{ url }}</span>
        </p>
    </div>

    <p style="margin-top: 30px; font-size: 13px;">Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet email en toute sécurité.</p>
    
    <p style="margin-top: 30px; font-weight: 700;">L'équipe Immoplus</p>
{% endblock %}
