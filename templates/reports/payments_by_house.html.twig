<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>{{ title }}</title>
		<style>
			@page { margin: 120px 40px 80px; }
			header { position: fixed; top: -100px; left: 0; right: 0; height: 100px; border-bottom: 2px solid #7C3AED; padding-bottom: 5px; }
			footer { position: fixed; bottom: -60px; left: 0; right: 0; height: 40px; border-top: 1px solid #eee; text-align: center; font-size: 8px; color: #999; padding-top: 5px; }
			body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #333; margin: 0; }
			.logo-container { float: left; width: 150px; }
			.logo-container img { max-width: 140px; max-height: 50px; }
			.company-info { float: right; text-align: right; width: 350px; font-size: 9px; line-height: 1.3; }
			.company-name { color: #7C3AED; font-size: 16px; font-weight: bold; margin-bottom: 2px; }
			.report-title { clear: both; text-align: center; margin-top: 20px; text-transform: uppercase; font-size: 16px; font-weight: bold; color: #444; }
			.report-period { text-align: center; color: #777; font-style: italic; margin-bottom: 30px; }
			.group-container { margin-top: 30px; }
			.group-title { background: #7C3AED; color: #fff; padding: 10px; font-size: 12px; font-weight: bold; border-radius: 4px 4px 0 0; }
			.data-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; border-radius: 0 0 4px 4px; overflow: hidden; border: 1px solid #eee; border-top: none; }
			.data-table th { background: #fdfdfd; color: #555; padding: 8px; text-align: left; font-size: 9px; border-bottom: 1px solid #eee; }
			.data-table td { padding: 8px; font-size: 10px; border-bottom: 1px solid #f9f9f9; }
			.amount { text-align: right; font-weight: bold; }
			.total-row td { background: #f5f5f5; font-weight: bold; color: #333; border-top: 2px solid #ddd; }
			.clear { clear: both; }
			.pagenum:before { content: counter(page); }
			.badge { background: #f0ebf8; color: #7C3AED; padding: 3px 6px; border-radius: 4px; font-size: 9px; text-transform: uppercase; font-weight: bold; border: 1px solid #e0d4f3; }
		</style>
	</head>
	<body>
		<header>
			<div class="logo-container">
				{% if logo %}
					<img src="{{ logo }}" alt="Logo">
				{% else %}
					<div style="font-size: 24px; font-weight: bold; color: #7C3AED;">{{ entreprise.denomination|default('motiplus') }}</div>
				{% endif %}
			</div>
			<div class="company-info">
				<div class="company-name">{{ entreprise.denomination|default('motiplus') }}</div>
				<div>{{ entreprise.adresse|default('') }} {{ entreprise.ville|default('') }}</div>
				<div>Tél: {{ entreprise.contacts|default('') }} / {{ entreprise.mobile|default('') }}</div>
				<div>Email: {{ entreprise.email|default('') }}</div>
			</div>
			<div class="clear"></div>
		</header>

		<footer>
			<div>Document généré par motiplus System le {{ "now"|date("d/m/Y H:i") }}</div>
			<div style="margin-top: 2px;">Page <span class="pagenum"></span></div>
		</footer>

		<main>
			<div class="report-title">{{ title }}</div>
			<div class="report-period">Période du {{ startDate|date('d/m/Y') }} au {{ endDate|date('d/m/Y') }}</div>

			{% set grand_total = 0 %}

			{% for item in data %}
				{% set grand_total = grand_total + item.total_amount %}

				<div class="group-container">
					<div class="group-title">{{ item.maison|upper }}</div>
					<table class="data-table">
						<thead>
							<tr>
								<th>Date et Heure</th>
								<th>Référence</th>
								<th>Locataire</th>
								<th>Mode Paiement</th>
								<th class="amount">Montant (F CFA)</th>
							</tr>
						</thead>
						<tbody>
							{% for t in item.transactions %}
								<tr>
									<td>{{ t.date }}</td>
									<td>{{ t.reference }}</td>
									<td>{{ t.locataire }}</td>
									<td><span class="badge">{{ t.mode }}</span></td>
									<td class="amount">{{ t.montant|number_format(0, ',', ' ') }}</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" style="text-align: center; color: #999; padding: 20px;">Aucun encaissement sur cette période.</td>
								</tr>
							{% endfor %}
							{% if item.transactions|length > 0 %}
								<tr class="total-row">
									<td colspan="4" style="text-align: right;">SOUS-TOTAL ENCAISSEMENTS</td>
									<td class="amount" style="color: #7C3AED; font-size: 12px;">{{ item.total_amount|number_format(0, ',', ' ') }}</td>
								</tr>
							{% endif %}
						</tbody>
					</table>
				</div>
			{% else %}
				<p style="text-align: center; color: #666; margin-top: 50px;">Aucune donnée disponible pour cette période.</p>
			{% endfor %}

			{% if data|length > 0 %}
				<div style="margin-top: 30px; border: 2px solid #7C3AED; border-radius: 8px; padding: 15px; background: #faf5ff; text-align: center;">
					<span style="font-weight: bold; font-size: 16px; color: #333;">TOTAL DES ENCAISSEMENTS GLOBAUX : </span>
					<span class="amount" style="font-weight: bold; font-size: 18px; color: #7C3AED;">{{ grand_total|number_format(0, ',', ' ') }} F CFA</span>
				</div>
			{% endif %}

		</main>
	</body>
</html>
