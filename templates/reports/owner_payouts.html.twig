<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>{{ title }}</title>
		<style>
			@page {
				margin: 120px 40px 80px;
			}
			header {
				position: fixed;
				top: -100px;
				left: 0;
				right: 0;
				height: 100px;
				border-bottom: 2px solid #7C3AED;
				padding-bottom: 5px;
			}
			footer {
				position: fixed;
				bottom: -60px;
				left: 0;
				right: 0;
				height: 40px;
				border-top: 1px solid #eee;
				text-align: center;
				font-size: 8px;
				color: #999;
				padding-top: 5px;
			}
			body {
				font-family: DejaVu Sans, sans-serif;
				font-size: 9px;
				color: #333;
				margin: 0;
			}

			.logo-container {
				float: left;
				width: 150px;
			}
			.logo-container img {
				max-width: 140px;
				max-height: 50px;
			}
			.company-info {
				float: right;
				text-align: right;
				width: 350px;
				font-size: 9px;
				line-height: 1.3;
			}
			.company-name {
				color: #7C3AED;
				font-size: 16px;
				font-weight: bold;
				margin-bottom: 2px;
			}

			.report-title {
				clear: both;
				text-align: center;
				margin-top: 20px;
				text-transform: uppercase;
				font-size: 16px;
				font-weight: bold;
				color: #444;
			}
			.report-period {
				text-align: center;
				color: #777;
				font-style: italic;
				margin-bottom: 20px;
			}

			table.data-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 10px;
			}
			table.data-table th {
				background: #333;
				color: #fff;
				padding: 8px;
				text-align: left;
				text-transform: uppercase;
				font-size: 8px;
			}
			table.data-table td {
				border-bottom: 1px solid #eee;
				padding: 8px;
				vertical-align: top;
			}
			.row-even {
				background: #fcfcfc;
			}
			.amount {
				text-align: right;
				font-weight: bold;
				color: #7C3AED;
			}

			.clear {
				clear: both;
			}
			.pagenum:before {
				content: counter(page);
			}
		</style>
	</head>
	<body>
		<header>
			<div class="logo-container">
				{% if logo %}
					<img src="{{ logo }}" alt="Logo">
				{% else %}
					<div style="font-size: 24px; font-weight: bold; color: #7C3AED;">{{ entreprise.denomination|default('motiplus') }}</div>
				{% endif %}
			</div>
			<div class="company-info">
				<div class="company-name">{{ entreprise.denomination|default('motiplus') }}</div>
				<div>{{ entreprise.adresse|default('') }}
					{{ entreprise.ville|default('') }}</div>
				<div>Tél:
					{{ entreprise.contacts|default('') }}
					/
					{{ entreprise.mobile|default('') }}</div>
				<div>Email:
					{{ entreprise.email|default('') }}</div>
			</div>
			<div class="clear"></div>
		</header>

		<footer>
			<div>Document généré par motiplus System le
				{{ "now"|date("d/m/Y H:i") }}</div>
			<div style="margin-top: 2px;">Page
				<span class="pagenum"></span>
			</div>
		</footer>

		<main>
			<div class="report-title">Journal des Versements Propriétaires</div>
			<div class="report-period">Versements effectués du
				{{ startDate|date('d/m/Y') }}
				au
				{{ endDate|date('d/m/Y') }}</div>

			<table class="data-table" cellspacing="0">
				<thead>
					<tr>
						<th>Date</th>
						<th>Propriétaire</th>
						<th>Libellé / Détail</th>
						<th>Maison</th>
						<th class="amount">Montant (FCFA)</th>
					</tr>
				</thead>
				<tbody>
					{% set grand_total = 0 %}
					{% for p in payments %}
						{% set grand_total = grand_total + p.montant %}
						<tr class="{{ loop.index is even ? 'row-even' : '' }}">
							<td>{{ p.dateVersement|date("d/m/Y") }}</td>
							<td>
								<strong>{{ p.proprio.nom }}
									{{ p.proprio.prenoms }}</strong>
							</td>
							<td>{{ p.libelle }}</td>
							<td>{{ p.maison.libMaison|default('N/A') }}</td>
							<td class="amount">{{ p.montant|number_format(0, ',', ' ') }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" style="text-align: center; padding: 40px; color: #999;">Aucun versement enregistré sur cette période.</td>
						</tr>
					{% endfor %}
				</tbody>
				{% if payments|length > 0 %}
					<tfoot>
						<tr style="background: #eee; font-weight: bold;">
							<td colspan="4" style="text-align: right; padding: 10px;">TOTAL DES REVERSEMENTS</td>
							<td class="amount" style="padding: 10px; font-size: 12px;">{{ grand_total|number_format(0, ',', ' ') }}</td>
						</tr>
					</tfoot>
				{% endif %}
			</table>
		</main>
	</body>
</html>
