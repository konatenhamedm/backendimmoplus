<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>{{ title }}</title>
		<style>
			@page {
				margin: 120px 40px 80px;
			}
			header {
				position: fixed;
				top: -100px;
				left: 0;
				right: 0;
				height: 100px;
				border-bottom: 2px solid #ff6600;
				padding-bottom: 5px;
			}
			footer {
				position: fixed;
				bottom: -60px;
				left: 0;
				right: 0;
				height: 40px;
				border-top: 1px solid #eee;
				text-align: center;
				font-size: 8px;
				color: #999;
				padding-top: 5px;
			}
			body {
				font-family: DejaVu Sans, sans-serif;
				font-size: 9px;
				color: #333;
				margin: 0;
			}

			.logo-container {
				float: left;
				width: 150px;
			}
			.logo-container img {
				max-width: 140px;
				max-height: 50px;
			}
			.company-info {
				float: right;
				text-align: right;
				width: 350px;
				font-size: 9px;
				line-height: 1.3;
			}
			.company-name {
				color: #ff6600;
				font-size: 16px;
				font-weight: bold;
				margin-bottom: 2px;
			}

			.report-title {
				clear: both;
				text-align: center;
				margin-top: 20px;
				text-transform: uppercase;
				font-size: 16px;
				font-weight: bold;
				color: #444;
			}

			.campaign-section {
				margin-top: 20px;
				border: 1px solid #ccc;
				border-radius: 8px;
				overflow: hidden;
				page-break-inside: avoid;
			}
			.campaign-header {
				background: #333;
				color: #fff;
				padding: 10px;
			}
			.campaign-name {
				font-size: 14px;
				font-weight: bold;
			}
			.campaign-stats {
				float: right;
				font-size: 10px;
				margin-top: 4px;
			}

			table.data-table {
				width: 100%;
				border-collapse: collapse;
			}
			table.data-table th {
				background: #f5f5f5;
				color: #666;
				padding: 8px;
				text-align: left;
				font-size: 8px;
				border-bottom: 1px solid #eee;
			}
			table.data-table td {
				padding: 8px;
				border-bottom: 1px solid #f9f9f9;
			}

			.badge {
				background: #e3f2fd;
				color: #1565c0;
				padding: 2px 6px;
				border-radius: 4px;
				font-size: 8px;
				font-weight: bold;
			}
			.amount {
				text-align: right;
				font-weight: bold;
			}

			.clear {
				clear: both;
			}
			.pagenum:before {
				content: counter(page);
			}
		</style>
	</head>
	<body>
		<header>
			<div class="logo-container">
				{% if logo %}
					<img src="{{ logo }}" alt="Logo">
				{% else %}
					<div style="font-size: 24px; font-weight: bold; color: #ff6600;">{{ entreprise.denomination|default('ImmoPlus') }}</div>
				{% endif %}
			</div>
			<div class="company-info">
				<div class="company-name">{{ entreprise.denomination|default('ImmoPlus') }}</div>
				<div>{{ entreprise.adresse|default('') }}
					{{ entreprise.ville|default('') }}</div>
				<div>Tél:
					{{ entreprise.contacts|default('') }}
					/
					{{ entreprise.mobile|default('') }}</div>
				<div>Email:
					{{ entreprise.email|default('') }}</div>
			</div>
			<div class="clear"></div>
		</header>

		<footer>
			<div>Document généré par ImmoPlus System le
				{{ "now"|date("d/m/Y H:i") }}</div>
			<div style="margin-top: 2px;">Page
				<span class="pagenum"></span>
			</div>
		</footer>

		<main>
			<div class="report-title">Répartition par Campagne</div>
			<p style="text-align: center; color: #666;">Liste des appartements et occupations associés aux campagnes actives.</p>

			{% for c in campaigns %}
				<div class="campaign-section">
					<div class="campaign-header">
						<div class="campaign-stats">Total :
							<strong>{{ c.total_amount|number_format(0, ',', ' ') }}
								FCFA</strong>
							| Payé :
							<strong>{{ c.total_paid|default(0)|number_format(0, ',', ' ') }}
								FCFA</strong>
						</div>
						<div class="campaign-name">{{ c.campagne }}</div>
					</div>
					<table class="data-table" cellspacing="0">
						<thead>
							<tr>
								<th style="width: 30%;">Appartement</th>
								<th style="width: 30%;">Maison</th>
								<th>Locataire Actuel</th>
								<th class="amount" style="width: 20%;">Loyer Prévu</th>
							</tr>
						</thead>
						<tbody>
							{% for a in c.appartements %}
								<tr>
									<td>
										<strong>{{ a.nom }}</strong>
									</td>
									<td style="color: #666; font-size: 8px;">{{ a.maison }}</td>
									<td>
										<span class="badge">{{ a.locataire }}</span>
									</td>
									<td class="amount">{{ a.loyer|number_format(0, ',', ' ') }}</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="4" style="text-align: center; padding: 20px; color: #999; font-style: italic;">Aucun appartement associé à cette campagne.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% else %}
				<div style="text-align: center; padding: 60px; color: #ccc;">
					Aucune campagne disponible.
				</div>
			{% endfor %}
		</main>
	</body>
</html>
