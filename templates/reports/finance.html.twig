<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>{{ title }}</title>
		<style>
			@page {
				margin: 120px 40px 80px;
			}
			header {
				position: fixed;
				top: -100px;
				left: 0;
				right: 0;
				height: 100px;
				border-bottom: 2px solid #ff6600;
				padding-bottom: 5px;
			}
			footer {
				position: fixed;
				bottom: -60px;
				left: 0;
				right: 0;
				height: 40px;
				border-top: 1px solid #eee;
				text-align: center;
				font-size: 8px;
				color: #999;
				padding-top: 5px;
			}
			body {
				font-family: DejaVu Sans, sans-serif;
				font-size: 10px;
				color: #333;
				margin: 0;
			}

			.logo-container {
				float: left;
				width: 150px;
			}
			.logo-container img {
				max-width: 140px;
				max-height: 50px;
			}
			.company-info {
				float: right;
				text-align: right;
				width: 350px;
				font-size: 9px;
				line-height: 1.3;
			}
			.company-name {
				color: #ff6600;
				font-size: 16px;
				font-weight: bold;
				margin-bottom: 2px;
			}

			.report-title {
				clear: both;
				text-align: center;
				margin-top: 20px;
				text-transform: uppercase;
				font-size: 16px;
				font-weight: bold;
				color: #444;
			}
			.report-period {
				text-align: center;
				color: #777;
				font-style: italic;
				margin-bottom: 30px;
			}

			.summary-container {
				margin-top: 50px;
			}
			.summary-card {
				background: #fdfdfd;
				border: 1px solid #eee;
				border-radius: 8px;
				overflow: hidden;
			}
			.summary-card th {
				background: #ff6600;
				color: #fff;
				padding: 10px;
				text-align: left;
				font-size: 11px;
			}
			.summary-card td {
				padding: 10px;
				border-bottom: 1px solid #f5f5f5;
			}
			.summary-card .label {
				font-weight: bold;
				color: #666;
				width: 60%;
			}
			.summary-card .value {
				text-align: right;
				font-weight: bold;
				font-size: 14px;
			}

			.outstanding {
				color: #e63946;
			}
			.paid {
				color: #2a9d8f;
			}

			.clear {
				clear: both;
			}
			.pagenum:before {
				content: counter(page);
			}
		</style>
	</head>
	<body>
		<header>
			<div class="logo-container">
				{% if logo %}
					<img src="{{ logo }}" alt="Logo">
				{% else %}
					<div style="font-size: 24px; font-weight: bold; color: #ff6600;">{{ entreprise.denomination|default('ImmoPlus') }}</div>
				{% endif %}
			</div>
			<div class="company-info">
				<div class="company-name">{{ entreprise.denomination|default('ImmoPlus') }}</div>
				<div>{{ entreprise.adresse|default('') }}
					{{ entreprise.ville|default('') }}</div>
				<div>Tél:
					{{ entreprise.contacts|default('') }}
					/
					{{ entreprise.mobile|default('') }}</div>
				<div>Email:
					{{ entreprise.email|default('') }}</div>
			</div>
			<div class="clear"></div>
		</header>

		<footer>
			<div>Document généré par ImmoPlus System le
				{{ "now"|date("d/m/Y H:i") }}</div>
			<div style="margin-top: 2px;">Page
				<span class="pagenum"></span>
			</div>
		</footer>

		<main>
			<div class="report-title">{{ title }}</div>
			<div class="report-period">Période du
				{{ startDate|date('d/m/Y') }}
				au
				{{ endDate|date('d/m/Y') }}</div>

			<div class="summary-container">
				<table class="summary-card" width="100%" cellspacing="0">
					<thead>
						<tr>
							<th colspan="2">Synthèse Financière</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="label">Total Facturé</td>
							<td class="value">{{ summary.total_billed|number_format(0, ',', ' ') }}
								FCFA</td>
						</tr>
						<tr>
							<td class="label">Total Encaissé</td>
							<td class="value paid">{{ summary.total_paid|number_format(0, ',', ' ') }}
								FCFA</td>
						</tr>
						<tr>
							<td class="label">Reste à Recouvrer</td>
							<td class="value outstanding">{{ summary.total_outstanding|number_format(0, ',', ' ') }}
								FCFA</td>
						</tr>
						<tr>
							<td class="label">Taux de Collecte</td>
							<td class="value" style="color: #457b9d;">{{ summary.collection_rate }}%</td>
						</tr>
					</tbody>
				</table>
			</div>
		</main>
	</body>
</html>
